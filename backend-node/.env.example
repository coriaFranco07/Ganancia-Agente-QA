PORT=8001
MONGODB_URI=mongodb://127.0.0.1:27017/auditoria_ganancias
MAX_UPLOAD_MB=20
TOLERANCIA_REDONDEO=0.05
NODE_ENV=development

# Sesion/login
# Los usuarios NO se definen aca: se guardan en MongoDB con password_hash.
# Crear usuario con: npm run usuario:crear -- --correo usuario@empresa.com
JWT_SECRET=cambiar-por-una-clave-larga-de-32-caracteres-minimo
SESSION_HOURS=8

# Explicaciones IA opcionales. Gemini no calcula impuestos: solo redacta hallazgos del motor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELOS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000
GEMINI_REINTENTOS=3
GEMINI_REINTENTO_BASE_MS=1200

# ── QA Spider: generador desde spec y ejecucion individual de casos ─────────
# El runner (scripts/run-qa-spider.mjs) navega la app real con Playwright, asi
# que necesita saber donde esta el frontend y con que usuario entrar. Ese
# usuario lo crea el propio runner por upsert en la coleccion `usuarios`.
AUDITORIA_FRONTEND_URL=http://localhost:4200
AUDITORIA_QA_CORREO=qa-local@auditoria.test
AUDITORIA_QA_PASSWORD=qa-local-123456

# Opcionales: los valores de abajo son los defaults del runner.
# Tope por linea de un caso "script", para no esperar el timeout global cuando
# la app deja un boton deshabilitado por validacion.
QA_SPIDER_TIMEOUT_LINEA_SCRIPT_MS=8000
# "false" desactiva los casos con codigo Playwright embebido.
QA_SPIDER_PERMITIR_SCRIPT=true
# "true" hace que la corrida termine con codigo 1 si hubo hallazgos.
QA_SPIDER_FALLAR_EN_HALLAZGOS=false
# Catalogo extra que se superpone al base (ruta relativa a backend-node/).
QA_SPIDER_CASOS_FILE=
# El backend fuerza PLAYWRIGHT_HEADLESS=false al lanzar el runner: la corrida
# se ve en pantalla. Solo aplica si se corre el script a mano.
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOWMO_MS=50
