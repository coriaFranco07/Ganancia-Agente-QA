{
  "name": "auditoria-ganancias-backend-node",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": "18.14.x"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest --runInBand",
    "test:golden": "jest --runInBand --config test/jest-golden.json",
    "test:e2e": "jest --runInBand --config test/jest-e2e.json",
    "test:mongo": "jest --runInBand --config test/jest-mongo.json",
    "qa:chat:e2e": "node scripts/run-qa-chat-e2e.mjs",
    "qa:playwright": "node scripts/run-qa-cases-playwright.mjs",
    "qa:playwright:demo": "node scripts/run-qa-cases-playwright.mjs --demo",
    "qa:sop-loom": "node scripts/run-qa-sop-loom-playwright.mjs",
    "qa:sop-loom:demo": "node scripts/run-qa-sop-loom-playwright.mjs --demo",
    "usuario:crear": "ts-node scripts/crear-usuario.ts"
  },
  "dependencies": {
    "@nestjs/common": "9.4.3",
    "@nestjs/config": "2.3.4",
    "@nestjs/core": "9.4.3",
    "@nestjs/mongoose": "9.2.2",
    "@nestjs/platform-express": "9.4.3",
    "@playwright/test": "^1.46.0",
    "axe-core": "^4.13.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "decimal.js": "10.4.3",
    "exceljs": "4.4.0",
    "mongoose": "7.8.7",
    "multer": "1.4.5-lts.2",
    "playwright-core": "1.46.0",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "9.5.0",
    "@nestjs/schematics": "9.2.0",
    "@nestjs/testing": "9.4.3",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.12",
    "@types/node": "18.19.76",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "mongodb-memory-server": "^8.16.1",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "4.9.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
